{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@commitlint/config-conventional",
    "@commitlint/types"
  ],
  "ignoreBinaries": ["mkfifo"],
  "ignoreIssues": {
    "packages/m3l-common/src/core/environment/index.ts": ["duplicates"],
    "packages/m3l-common/src/aws/cloudwatch-metrics/index.ts": ["types"],
    "packages/m3l-common/src/aws/cloudwatch-metrics/types.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        ".claude/hooks/**/*.mjs",
        ".claude/workflows/**/*.js",
        "bin/*.mjs"
      ],
      "project": ["bin/**/*.mjs"]
    },
    "packages/m3l-cli": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "bin/**/*.mjs"],
      "ignoreDependencies": [
        "@m3l-automation/api-gateway-client",
        "@m3l-automation/athena-query",
        "@m3l-automation/cloudformation-stacks",
        "@m3l-automation/cloudwatch-logs-analysis",
        "@m3l-automation/cloudwatch-logs-insights",
        "@m3l-automation/codepipeline-ops",
        "@m3l-automation/dynamodb-crud",
        "@m3l-automation/ecs-ops",
        "@m3l-automation/eks-ops",
        "@m3l-automation/eventbridge-schedules",
        "@m3l-automation/json-etl",
        "@m3l-automation/lambda-ops",
        "@m3l-automation/rds-data-sql",
        "@m3l-automation/s3-objects",
        "@m3l-automation/sqs-dead-letter-triage",
        "@m3l-automation/sqs-etl"
      ]
    },
    "packages/m3l-common": {
      "entry": "src/index.ts",
      "project": "src/**/*.ts"
    },
    "packages/m3l-console-server": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "bin/**/*.mjs"]
    },
    "packages/m3l-console-web": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "scripts/*": {
      "entry": "src/{main,command}.ts",
      "project": "src/**/*.ts"
    }
  }
}

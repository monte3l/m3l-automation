#
# Two-stage build for the console server (ADR-0071, X12/issue #560; engine
# changed from Docker to Podman by ADR-0091).
#
# `pnpm deploy` (not `COPY node_modules`) produces the runtime stage's
# dependency tree: a workspace `node_modules` is full of `workspace:*`
# symlinks back into `/repo`, which don't resolve once the builder stage is
# discarded. `deploy` writes real, self-contained copies instead.
#
# Build from the repo root: `podman build -f packages/m3l-console-server/Containerfile .`
# (also what `pnpm console:up` does, via bin/console-up.mjs).
#
# `node:24-slim` is pinned by digest, not just tag: a tag alone is a moving
# target, and `.github/dependabot.yml`'s `docker` ecosystem entries only have
# something to bump if this file pins a digest for them to update. A
# stale/incorrect digest fails the pull loudly (Podman verifies it
# cryptographically) rather than silently resolving to the wrong image.
# Fully qualified with `docker.io/library/` — Podman refuses to guess a
# registry for a short image name the way Docker does (ADR-0091's scoped
# exception: `docker.io` here names a registry hostname, not the banned tool).

FROM docker.io/library/node:24-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS builder
WORKDIR /repo

# ADR-0001: no Corepack in this repo. pnpm is installed directly, pinned to
# the exact `packageManager` version — the same version pnpm/action-setup
# resolves for CI, just without Corepack as the install mechanism.
RUN npm install --global pnpm@11.9.0

COPY . .
# `--ignore-scripts`: the root `prepare` script (`lefthook install && node
# bin/install-merge-drivers.mjs`) needs a real git work tree and the `git`
# binary — `.git` is containerignored and `node:24-slim` ships no `git` at
# all, so `prepare` fails the build outright otherwise. A follow-up `pnpm
# rebuild` is NOT needed and NOT safe here: bare `pnpm rebuild` targets the
# workspace root too and re-runs the same failing `prepare` hook. It's also
# moot — better-sqlite3 (ADR-0069's embedded store) ships a prebuilt binary
# (`gypfile: false`), so pnpm never triggers a native build for it regardless
# of `--ignore-scripts`.
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm exec turbo run build --filter=@m3l-automation/m3l-console-server...
# `--legacy`: plain `pnpm --prod deploy` fails outright on a workspace whose
# packages aren't injected (`ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE`).
# `--ignore-scripts`: `pnpm deploy` is a SEPARATE command from the `pnpm
# install --ignore-scripts` above and does not inherit that flag — without
# it, the deploy re-runs better-sqlite3's install script, which falls
# through to `node-gyp rebuild` and fails (no Python in this image). Both
# flags were missing before ADR-0091's spike actually ran this build for the
# first time; this defect predates Podman and would have broken `docker
# build` identically.
RUN pnpm --filter @m3l-automation/m3l-console-server --prod deploy /deploy --legacy --ignore-scripts

FROM docker.io/library/node:24-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS runtime
WORKDIR /app

# `Core.M3LPaths().getDataDir()` (config/paths.ts's `resolveStoreDatabasePath`
# calls it even when `M3L_CONSOLE_DB_PATH` is set) auto-detects MONOREPO mode
# by walking up for `pnpm-workspace.yaml` — a marker this image, containing
# only the deployed package, will never have. Force STANDALONE mode and
# anchor its base directory at the volume mount, or the server fails to boot.
ENV M3L_DEPLOYMENT_MODE=standalone
ENV M3L_DATA_DIR=/data
ENV NODE_ENV=production

COPY --from=builder --chown=node:node /deploy /app

# The official image's non-root `node` user (uid 1000, home `/home/node`) —
# matches console-pod.yaml's host-SSO volume mount target.
USER node

EXPOSE 8787

# `node:24-slim` ships neither curl nor wget; the global `fetch` (Node 24) is
# the only HTTP client guaranteed present. Always targets 127.0.0.1 — the
# origin guard's Host check runs in `preRouting` ahead of this route too
# (main.ts), so a probe aimed at a service name or container IP gets a 400,
# not a 200.
#
# No `HEALTHCHECK` instruction: Podman's default OCI build format silently
# ignores it (confirmed by ADR-0091's spike — a build-time warning, not an
# error), and the real, working probe is console-pod.yaml's `livenessProbe`,
# which runs this exact command via `exec` rather than `httpGet` (`podman
# kube play` translates `httpGet` into an in-container `curl`, which this
# image doesn't have). A bare `podman run` of this image gets no
# self-healthcheck as a result — that trade-off is accepted; the pod
# manifest is the supported way to run this image.

CMD ["node", "bin/m3l-console-server.mjs"]

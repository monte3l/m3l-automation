#
# Two-stage build for the console frontend (ADR-0071, X12/issue #560; engine
# changed from Docker to Podman by ADR-0091).
#
# Build from the repo root: `podman build -f packages/m3l-console-web/Containerfile .`
# (also what `pnpm console:up` does, via bin/console-up.mjs).
#
# Both base images are pinned by digest, not just tag: a tag alone is a
# moving target, and `.github/dependabot.yml`'s `docker` ecosystem entries
# only have something to bump if this file pins a digest for them to update.
# A stale/incorrect digest fails the pull loudly (Podman verifies it
# cryptographically) rather than silently resolving to the wrong image.
# Both are fully qualified with `docker.io/` — Podman refuses to guess a
# registry for a short image name the way Docker does (ADR-0091's scoped
# exception: `docker.io` here names a registry hostname, not the banned tool).

FROM docker.io/library/node:26-slim@sha256:c0753125a3789977aefe869cbebccf70e3cfd7ea84ca48547458f02e4f1d7146 AS builder
WORKDIR /repo

# ADR-0001: no Corepack in this repo. pnpm is installed directly, pinned to
# the exact `packageManager` version — the same version pnpm/action-setup
# resolves for CI, just without Corepack as the install mechanism.
RUN npm install --global pnpm@11.9.0

COPY . .
# `--ignore-scripts`: the root `prepare` script (`lefthook install && node
# bin/install-merge-drivers.mjs`) needs a real git work tree and the `git`
# binary — `.git` is containerignored and `node:24-slim` ships no `git` at
# all, so `prepare` fails the build outright otherwise. A follow-up `pnpm
# rebuild` is NOT needed and NOT safe here: bare `pnpm rebuild` targets the
# workspace root too and re-runs the same failing `prepare` hook. It's also
# moot — better-sqlite3 (ADR-0069's embedded store) ships a prebuilt binary
# (`gypfile: false`), so pnpm never triggers a native build for it regardless
# of `--ignore-scripts`.
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm exec turbo run build --filter=@m3l-automation/m3l-console-web...

# `nginx-unprivileged` (not plain `nginx`): the only published port in
# console-pod.yaml belongs to this image, and it is the SSE reverse proxy
# for `/api/v1/runs/:id/stream` (container/default.conf), not merely a
# static file server — see ADR-0071's Update for the minimal-dependency
# reconciliation. Already runs as uid 101 on port 8080; no custom USER/port
# needed.
FROM docker.io/nginxinc/nginx-unprivileged:1-alpine@sha256:aa8c9087d36d93e9d650c5365f883b421e8214aedbad24ade52b844c583358f1 AS runtime

COPY --from=builder /repo/packages/m3l-console-web/dist /usr/share/nginx/html
COPY packages/m3l-console-web/container/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

# No `HEALTHCHECK` instruction: Podman's default OCI build format silently
# ignores it (confirmed by ADR-0091's spike). console-pod.yaml's
# `livenessProbe` (exec + wget, for consistency with the server container's
# probe rather than an unstated dependency on this image carrying `curl`) is
# the real, working mechanism. A bare `podman run` of this image gets no
# self-healthcheck as a result — that trade-off is accepted; the pod
# manifest is the supported way to run this image.

{
  "name": "@m3l-automation/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root for @m3l-automation/m3l-common and the automation scripts that consume it.",
  "author": "Enrico Lionello",
  "keywords": [
    "automation",
    "aws",
    "typescript",
    "esm",
    "monorepo"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p bin/tsconfig.json",
    "lint": "pnpm lint:library && pnpm lint:workspace",
    "lint:library": "eslint packages/m3l-common --concurrency=1",
    "lint:workspace": "eslint . --ignore-pattern 'packages/m3l-common/**' --concurrency=1",
    "lint:commit": "node bin/lint-commit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "rumdl check . --no-cache --deny-config-warnings --exclude \"node_modules/**,.claude/**,**/dist/**,tmp/**,CHANGELOG.md,.github/pull_request_template.md,docs/adr/template.md,docs/plans/archive/**\"",
    "test": "vitest run && vitest run --config vitest.web.config.ts && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --coverage --config vitest.bin.config.ts && vitest run --coverage --config vitest.web.config.ts && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @m3l-automation/m3l-console-web test:e2e",
    "knip": "knip",
    "verify": "node bin/verify-all.mjs",
    "check:verify-parity": "node bin/check-verify-parity.mjs",
    "commands": "node bin/list-commands.mjs",
    "m3l": "node packages/m3l-cli/bin/m3l.mjs",
    "console:server": "node packages/m3l-console-server/bin/m3l-console-server.mjs",
    "console:web": "pnpm --filter @m3l-automation/m3l-console-web dev",
    "check:command-catalog": "node bin/check-command-catalog.mjs",
    "check:workflow-build-order": "node bin/check-workflow-build-order.mjs",
    "check:api": "node bin/check-exports-snapshot.mjs",
    "check:browser-safe-subpath": "node bin/check-browser-safe-subpath.mjs",
    "check:provenance": "node bin/check-doc-provenance.mjs",
    "check:doc-counts": "node bin/check-doc-counts.mjs",
    "check:impl-counts": "node bin/check-impl-counts.mjs",
    "gen:counts": "node bin/gen-doc-counts.mjs",
    "sync:docs": "node bin/sync-docs.mjs",
    "sync:hub-issues": "node bin/sync-hub-issues.mjs",
    "check:hub-drift": "node bin/sync-hub-issues.mjs --check",
    "sync:hub-projects": "node bin/sync-hub-projects.mjs",
    "sync:hub": "node bin/sync-hub.mjs",
    "check:doc-exports": "node bin/check-doc-exports.mjs",
    "check:exports": "publint packages/m3l-common && attw --pack packages/m3l-common --profile esm-only",
    "check:dts-deps": "node bin/check-dts-deps.mjs",
    "check:scaffold": "node bin/check-scaffold.mjs",
    "check:scaffold-seam": "node bin/check-scaffold-seam.mjs",
    "check:script-scaffold": "node bin/check-script-scaffold.mjs",
    "check:script-docs": "node bin/check-script-docs.mjs",
    "check:script-deps": "node bin/check-script-deps.mjs",
    "check:cli-scaffold": "node bin/check-cli-scaffold.mjs",
    "check:cli-docs": "node bin/check-cli-docs.mjs",
    "check:template-format": "node bin/check-template-format.mjs",
    "scaffold:script": "node bin/scaffold-script.mjs",
    "check:agents": "node bin/check-agents.mjs",
    "check:skill-frontmatter": "node bin/check-skill-frontmatter.mjs",
    "check:hooks": "node bin/check-hooks.mjs",
    "statusline:preview": "node bin/statusline-preview.mjs",
    "check:host-resources": "node bin/check-host-resources.mjs",
    "check:node-version": "node bin/check-node-version.mjs",
    "check:claude-cli-version": "node bin/check-claude-cli-version.mjs",
    "setup:host-resources": "node bin/setup-host-resources.mjs",
    "check:integration-stance": "node bin/check-integration-stance.mjs",
    "check:github-features": "node bin/check-github-features.mjs",
    "check:label-drift": "node bin/check-label-drift.mjs",
    "check:control-chars": "node bin/check-control-chars.mjs",
    "check:hub-views": "node bin/check-hub-views.mjs",
    "check:zones": "node bin/check-eslint-zones.mjs",
    "check:deps": "node bin/check-deps.mjs",
    "check:licenses": "node bin/check-licenses.mjs",
    "check:test-counts": "node bin/check-test-counts.mjs",
    "check:review-size": "node bin/check-review-size.mjs",
    "check:file-budget": "node bin/check-file-budget.mjs",
    "check:workflows": "node bin/check-workflows.mjs",
    "check:workflows-doc": "node bin/check-workflows-doc.mjs",
    "check:cadence": "node bin/check-cadence-doc.mjs",
    "check:context-budget": "node bin/check-context-budget.mjs",
    "check:harness-freshness": "node bin/check-harness-freshness.mjs",
    "check:retrospective": "node bin/check-retrospective.mjs",
    "check:skill-evals": "node bin/check-skill-evals.mjs",
    "check:review-policy": "node bin/check-review-policy.mjs",
    "maintain:scan": "node bin/run-maintain-scan.mjs",
    "eval:skills": "node bin/run-skill-evals.mjs",
    "check:tracker-coverage": "node bin/check-tracker-coverage.mjs",
    "check:tracker-status": "node bin/check-tracker-status.mjs",
    "check:hub-keys": "node bin/check-hub-keys.mjs",
    "check:worktree": "node bin/check-worktree-include.mjs",
    "check:signed-range": "node bin/verify-signed-range.mjs",
    "check:commit-trailers": "node bin/check-commit-trailers.mjs",
    "check:dup": "jscpd",
    "gen:index": "node bin/gen-reference-index.mjs",
    "gen:commit-stats-endpoint": "node bin/gen-commit-stats-endpoint.mjs",
    "gen:project-hub": "node bin/gen-project-hub.mjs",
    "notify:main-health": "node bin/notify-main-health.mjs",
    "check:index": "node bin/check-reference-index.mjs",
    "worktree:new": "node bin/worktree-new.mjs",
    "worktree:setup": "node bin/worktree-setup.mjs",
    "worktree:remove": "node bin/worktree-remove.mjs",
    "worktree:prune": "node bin/worktree-prune.mjs",
    "branch:cleanup": "node bin/branch-cleanup.mjs",
    "spoke:recover": "node bin/spoke-recovery.mjs",
    "telemetry:sessions": "node bin/session-telemetry.mjs",
    "session:launch": "node bin/claude-launch.mjs",
    "session:install-shell-hook": "node bin/install-session-shell-hook.mjs",
    "prepare": "lefthook install && node bin/install-merge-drivers.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/lint": "21.2.2",
    "@commitlint/load": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.9.0",
    "jscpd": "5.0.15",
    "jsdom": "30.0.1",
    "knip": "6.33.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "rumdl": "0.2.62",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}

{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "pnpm-lock.yaml"],
  // ADR-0080 originally fixed this at "50%" — a blind percentage of raw
  // logical cores that is the wrong number on SMT (x86_64 CI) and P/E-core
  // (Apple Silicon) hosts alike (docs/plans/2026-09-08-adaptive-host-budgeting.md).
  // Stage 2 of that plan replaced the static field with a per-invocation
  // `--concurrency=N` CLI flag, computed from the detected host profile by
  // `bin/print-concurrency.mjs` and passed through the `build`/`typecheck`
  // package.json scripts (turbo has no config-time compute seam, only a CLI
  // flag). Leaving no field here means a `turbo run <task>` invoked directly
  // (bypassing those scripts) falls back to turbo's own built-in default —
  // 10 concurrent tasks, the exact oversubscription this whole mechanism
  // exists to avoid — so always go through `pnpm build`/`pnpm typecheck`.
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // index.html/vite.config.ts/public/** only exist under
      // packages/m3l-console-web (ADR-0067's Vite build) — harmless
      // no-op globs for every tsc-only package, but needed so a change to
      // any of them invalidates that package's turbo cache.
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "index.html",
        "vite.config.ts",
        "public/**"
      ],
      "outputs": ["dist/**", "dist/.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig*.json", "package.json"]
    }
  }
}

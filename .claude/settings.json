{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint:md)",
      "Bash(pnpm lint:md *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:coverage *)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format:check *)",
      "Bash(gh pr view *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/monte3l/m3l-automation/code-scanning/alerts*)",
      "Bash(gh api repos/monte3l/m3l-automation/issues/*)",
      "Bash(gh api repos/monte3l/m3l-automation/commits/*)",
      "Bash(gh api repos/monte3l/m3l-automation/rulesets*)",
      "Bash(gh api repos/monte3l/m3l-automation/branches/main/protection*)",
      "Bash(gh run list *)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm exec eslint *)",
      "Bash(gh run view *)",
      "Bash(node_modules/.bin/prettier --check *)",
      "mcp__m3l__repo_verify",
      "mcp__m3l__catalog_query",
      "mcp__m3l__commit_lint",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__get_me",
      "mcp__github__add_issue_comment"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(curl)",
      "Bash(curl *)",
      "Bash(wget)",
      "Bash(wget *)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(gh auth refresh)",
      "Bash(gh auth refresh *)"
    ]
  },
  "availableModels": ["fable", "opus", "sonnet", "haiku"],
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline-context-pressure.mjs\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-worktree-ready.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-host-resources.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-node-version.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-compact-handoff.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rotate-session-incidents.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/write-compact-handoff.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-decision-gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-push-signed.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-readonly-bash.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writer-dispatch-journal.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-js-extension.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-no-commonjs.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.mjs\"",
            "if": "Write(**/dist/**)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.mjs\"",
            "if": "Edit(**/dist/**)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-eslint-disable-red.mjs\"",
            "if": "Write(packages/m3l-common/tests/**)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-eslint-disable-red.mjs\"",
            "if": "Edit(packages/m3l-common/tests/**)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-branch-isolation.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-hub-src-writes.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secret-writes.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-spoke-truncation.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-sync-docs.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-md-verify.mjs\"",
            "if": "Write(*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-md-verify.mjs\"",
            "if": "Edit(*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-exports-semver.mjs\"",
            "if": "Write(packages/m3l-common/package.json)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-exports-semver.mjs\"",
            "if": "Edit(packages/m3l-common/package.json)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Write(*.ts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Edit(*.ts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Write(*.mts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Edit(*.mts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Write(*.cts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.mjs\"",
            "if": "Edit(*.cts)",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-doc-counts.mjs\"",
            "if": "Write(docs/reference/**/*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-doc-counts.mjs\"",
            "if": "Edit(docs/reference/**/*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-doc-counts.mjs\"",
            "if": "Write(README.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-doc-counts.mjs\"",
            "if": "Edit(README.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-provenance-staleness.mjs\"",
            "if": "Write(packages/m3l-common/src/**)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-provenance-staleness.mjs\"",
            "if": "Edit(packages/m3l-common/src/**)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Write(docs/reference/**/*.provenance.json)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Edit(docs/reference/**/*.provenance.json)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Write(packages/m3l-common/src/**/index.ts)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Edit(packages/m3l-common/src/**/index.ts)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Write(docs/implementation-status.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Edit(docs/implementation-status.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Write(docs/reference/**/*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-index-staleness.mjs\"",
            "if": "Edit(docs/reference/**/*.md)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-red-phase-comments.mjs\"",
            "if": "Write(packages/m3l-common/src/**)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-red-phase-comments.mjs\"",
            "if": "Edit(packages/m3l-common/src/**)",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "remember@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true
  }
}

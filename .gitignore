# Dependencies
node_modules/

# Build output (tsc-owned; never committed)
dist/
*.tsbuildinfo

# LICENSE copied into the package at publish time by its `prepack` script
# (single source of truth stays at the repo root). Generated, never committed.
packages/m3l-common/LICENSE

# Turborepo local cache / logs
.turbo/

# rumdl markdown-lint cache (CI uses --no-cache; this guards manual runs)
.rumdl_cache/

# Test / coverage artifacts
coverage/

# M3LScript run output (timestamped archival dirs)
data/output/*
!data/output/.gitkeep

# Console server's embedded SQLite store (ADR-0069). Ignored at DIRECTORY
# level rather than as `*.sqlite`: WAL mode creates `-wal`/`-shm` sidecars
# alongside the main file, and a committed `-wal` is a corrupt-restore hazard
# — it would be replayed against a database it does not belong to.
data/console/

# Git worktrees created by `claude --worktree` / isolated spokes (nested checkouts)
.claude/worktrees/

# Local scratch/working directory: untracked operator source material read
# while authoring presets, plus hook-written ephemeral state (e.g.
# write-compact-handoff.mjs's tmp/compact-handoff.json, ADR-0078). Never
# committed, never formatted, never linted — mirrored in .prettierignore
# and the `lint:md` exclude list.
tmp/

# A subagent's own dispatch journal, when a dispatch prompt omits an
# explicit tmp/-scoped path and the spoke picks .scratch/ instead — nearly
# landed in a commit via `git add -A` once (2026-09-02,
# docs/logs/2026-09-02-session-incidents-counter.md). Backstop, not the
# fix: always hand writer spokes an explicit tmp/ journal path.
.scratch/

# Lefthook's own local-override mechanism (ADR-0080's
# bin/setup-host-resources.mjs writes one on a memory-constrained host to
# force pre-push serial): https://lefthook.dev/examples/lefthook-local
lefthook-local.yml

# Logs and OS cruft
*.log
.DS_Store

# Local env / secrets (NPM_TOKEN, GITHUB_TOKEN live in CI vault only)
.env
.env.*
!.env.example

# Claude
.claire/
# ADR-0061 (V7): the agent decision log. Non-sensitive by construction
# (parameter names, never values), but retained rather than pruned, so it
# is machine state, not source.
data/agent-log/

# ADR-0060 (V8): the agent-operator's cross-run daily invocation counter, held
# in a `Core.M3LCheckpointStore` envelope. Deliberately NOT under `data/output/`
# — that directory holds run artifacts and is the natural thing for an operator
# to clear, and clearing it must not silently reset a policy budget ceiling.
data/agent-state/

# The `m3l` CLI's script-discovery cache (`cli/paths.ts` → `resolveCacheDir`).
# Written by any `m3l list`/`doctor`/`inspect` invocation, so V8's agent-operator
# regenerates it on every health-check run. Derived machine state, not source.
data/cache/

# Playwright run artifacts (packages/m3l-console-web). `playwright.config.ts`
# sets no explicit outputDir, so a FAILING e2e run drops traces, screenshots,
# and an error-context.md into these defaults next to the package. A passing
# run cleans up after itself, which is exactly why this is easy to miss until
# a red run leaves them staged.
test-results/
playwright-report/
